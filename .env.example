APP_ENV=dev
APP_NAME=verigence-security
LOG_LEVEL=INFO

# Neon runtime pooler URL. Use postgresql+psycopg://...
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST-pooler/DB?sslmode=require
# Direct URL recommended for migrations.
MIGRATION_DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Active human-authentication boundary: Security -> Clerk Backend API only.
# Web/Mobile/Audit Core never receive this secret and require no Clerk publishable key.
CLERK_SECRET_KEY=replace-in-secret-store
CLERK_BACKEND_API_URL=https://api.clerk.com/v1

# Transitional compatibility only for the deprecated Clerk-token access-session bridge.
# These are not part of the active Web/Mobile -> Audit Core -> Security authentication path.
CLERK_ISSUER=
CLERK_JWT_KEY=
CLERK_AUTHORIZED_PARTIES=

# URL-safe base64 encoding of exactly 32 random bytes. Used only to encrypt the retrievable
# Platform-global onboarding key at rest. Keep this in the deployment secret store.
SECURITY_USER_ONBOARDING_KEY_ENCRYPTION_KEY=replace-with-urlsafe-base64-32-byte-key

# Verigence Security signing keys
SECURITY_TOKEN_ISSUER=verigence-security
SECURITY_TOKEN_AUDIENCE=verigence-platform
SECURITY_KEY_ID=sec-key-001
SECURITY_PRIVATE_KEY_PEM="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
SECURITY_PUBLIC_KEY_PEM="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# Backend-only Clerk bootstrap of the first Platform Super Admin.
SECURITY_BOOTSTRAP_ENABLED=false
SECURITY_BOOTSTRAP_SUPER_ADMIN_CLERK_USER_ID=user_replace_me
PLATFORM_ADMIN_TOKEN_TTL_MINUTES=15

# Legacy local Platform bootstrap settings are migration debt only and should remain disabled.
PLATFORM_BOOTSTRAP_ENABLED=false
PLATFORM_BOOTSTRAP_LOGIN=
PLATFORM_BOOTSTRAP_PASSWORD=

# DEV-only identity adapter. Must be false in UAT/production.
DEV_MOCK_AUTH_ENABLED=true
DEV_MOCK_SIGNING_SECRET=replace-with-local-dev-secret
DEV_MOCK_TOKEN_TTL_MINUTES=10

# Network risk adapter. mock is only allowed outside UAT/production.
NETWORK_RISK_MODE=mock
MOCK_NETWORK_RISK_STATUS=NOT_DETECTED

# Railway trusted ingress headers
TRUSTED_REMOTE_IP_HEADER=X-Real-IP
